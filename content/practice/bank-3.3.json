      "id": "b3.3.01",
      "n": 1,
      "prompt": "Rationalise the denominator of $\\dfrac{1}{2+\\sqrt{3}}$.",
      "answer": {
        "type": "expression",
        "value": "2-sqrt(3)",
        "variables": [],
        "noRootDenominator": true
      },
      "answerText": "2 − √3",
      "solution": [
        "Multiply the top and the bottom by 2 − √3.",
        "The bottom is 4 − 3 = 1."
      ],
      "langType": "§2 ex. 16",
      "hints": [
        "Use the number with the opposite sign."
      ]
    },
    {
      "id": "b3.3.02",
      "n": 2,
      "prompt": "Rationalise the denominator of $\\dfrac{3}{\\sqrt{7}-2}$.",
      "answer": {
        "type": "expression",
        "value": "sqrt(7)+2",
        "variables": [],
        "noRootDenominator": true
      },
      "answerText": "√7 + 2",
      "solution": [
        "Multiply the top and the bottom by √7 + 2.",
