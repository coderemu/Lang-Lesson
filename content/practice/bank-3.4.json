      "n": 5,
      "prompt": "Is $(\\sqrt{3})^4$ an integer? Is $(\\sqrt{3})^3$ rational?",
      "answer": {
        "type": "self-check"
      },
      "answerText": "Yes, 9; no, 3√3",
      "solution": [
