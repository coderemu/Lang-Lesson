      "id": "b3.4.01",
      "n": 1,
      "prompt": "Find $81^{1/4}$, $125^{2/3}$ and $32^{3/5}$. Type the three values.",
      "answer": {
        "type": "numbers",
        "values": [
          3,
          25,
          8
        ],
        "ordered": true
      },
      "answerText": "3, 25, 8",
      "solution": [
        "81^(1/4) = 3, because 3⁴ = 81.",
        "125^(2/3) = 5² = 25.",
        "32^(3/5) = 2³ = 8."
      ],
      "langType": "§3 ex. 2, 6",
      "hints": [
        "Take the root first."
      ]
    },
