      "n": 1,
      "prompt": "Prove: if $a < b$, then $a - c < b - c$.",
      "answer": {
        "type": "self-check"
      },
      "answerText": "(b − c) − (a − c) = b − a > 0",
      "solution": [
        "a < b means b − a > 0.",
        "(b − c) − (a − c) = b − a.",
        "So (b − c) − (a − c) > 0, that is a − c < b − c."
      ],
      "langType": "§4 ex. 5",
      "hints": [
        "Use the meaning of $<$."
      ]
    },
