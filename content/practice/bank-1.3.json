      "id": "b1.3.10",
      "n": 10,
      "prompt": "Prove $(b + c)a = ba + ca$ from $a(b + c) = ab + ac$.",
      "answer": {
        "type": "self-check"
      },
      "answerText": "Commutativity, three times",
      "solution": [
