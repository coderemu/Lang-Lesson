      "prompt": "Justify each step: $(3a)(5b) = 15ab$.",
      "answer": {
        "type": "self-check"
      },
      "answerText": "Associativity and commutativity",
      "solution": [
        "(3a)(5b) = 3(a(5b)) by associativity.",
        "= 3((5b)a) = 3(5(ba)) by commutativity and associativity.",
        "= (3 · 5)(ba) = 15ab."
      ],
      "langType": "§3 text"
    },
