  "problems": [
    { "id": "b1.2.01", "n": 1, "prompt": "Give the reason for each step: $(a + b) + (c + d) = (b + d) + (a + c)$.", "answer": { "type": "self-check" }, "answerText": "Associativity, then commutativity (several steps)", "solution": ["(a + b) + (c + d) = a + b + c + d (associativity)", "= b + d + a + c (commutativity, several times)", "= (b + d) + (a + c) (associativity)"], "langType": "§2 ex. 1–10" },
    { "id": "b1.2.02", "n": 2, "prompt": "Give the reason for each step: $(p + q) - (r + s) = (p - r) + (q - s)$.", "answer": { "type": "self-check" }, "answerText": "N5, then associativity and commutativity", "solution": ["(p + q) − (r + s) = p + q − r − s (N5)", "= p − r + q − s (commutativity)", "= (p − r) + (q − s) (associativity)"], "langType": "§2 ex. 1–10" },
    { "id": "b1.2.03", "n": 3, "prompt": "Show that $-(a + b + c + d) = -a - b - c - d$.", "answer": { "type": "self-check" }, "answerText": "N5 two times, with associativity", "solution": ["−(a + b + c + d) = −((a + b) + (c + d)) (associativity)", "= −(a + b) − (c + d) (N5)", "= −a − b − c − d (N5 two times)"], "langType": "§2 ex. 11" },
    { "id": "b1.2.04", "n": 4, "prompt": "Show that $-(a - b + c) = -a + b - c$.", "answer": { "type": "self-check" }, "answerText": "N5 and N4", "solution": ["−(a + (−b) + c) = −a − (−b) − c (N5)", "= −a + b − c (N4)"], "langType": "§2 ex. 12" },
    { "id": "b1.2.05", "n": 5, "prompt": "Show that $-(-a - b) = a + b$.", "answer": { "type": "self-check" }, "answerText": "N5 and N4", "solution": ["−(−a + (−b)) = −(−a) − (−b) (N5)", "= a + b (N4)"], "langType": "§2 ex. 13" },
    { "id": "b1.2.06", "n": 6, "prompt": "Solve $-5 + x = 3$.", "answer": { "type": "number", "value": 8, "mistakes": [ { "match": -2, "reply": "That is 3 + (−5). Add 5 to both sides: x = 3 + 5." } ] }, "answerText": "8", "solution": ["Add 5 to both sides: x = 3 + 5 = 8."], "langType": "§2 ex. 14–21", "verify": "3 + 5" },
    { "id": "b1.2.07", "n": 7, "prompt": "Solve $6 - x = 9$.", "answer": { "type": "number", "value": -3, "mistakes": [ { "match": 3, "reply": "Check: 6 − 3 = 3, not 9. Which x makes 6 − x equal to 9?" } ] }, "answerText": "−3", "solution": ["Subtract 6 from both sides: −x = 3.", "So x = −3 (N4)."], "langType": "§2 ex. 14–21", "verify": "6 - 9" },
    { "id": "b1.2.08", "n": 8, "prompt": "Solve $-x + 2 = -7$.", "answer": { "type": "number", "value": 9, "mistakes": [ { "match": -9, "reply": "You found −x = −9. Now use N4: x = −(−9)." } ] }, "answerText": "9", "solution": ["Subtract 2 from both sides: −x = −9.", "So x = 9 (N4)."], "langType": "§2 ex. 14–21", "verify": "2 + 7" },
    { "id": "b1.2.09", "n": 9, "prompt": "Solve $-8 - x = -1$.", "answer": { "type": "number", "value": -7, "mistakes": [ { "match": 7, "reply": "Check: −8 − 7 = −15, not −1. Which x makes −8 − x equal to −1?" } ] }, "answerText": "−7", "solution": ["Add 8 to both sides: −x = 7.", "So x = −7."], "langType": "§2 ex. 14–21", "verify": "-8 + 1" },
    { "id": "b1.2.10", "n": 10, "prompt": "Solve $x - 4 = -6$.", "answer": { "type": "number", "value": -2, "mistakes": [ { "match": -10, "reply": "That is −6 − 4. Add 4 to both sides: x = −6 + 4." } ] }, "answerText": "−2", "solution": ["Add 4 to both sides: x = −6 + 4 = −2."], "langType": "§2 ex. 14–21", "verify": "-6 + 4" },
    { "id": "b1.2.11", "n": 11, "prompt": "Prove: if $x + y = x + z$, then $y = z$.", "answer": { "type": "self-check" }, "answerText": "Add −x to both sides", "solution": ["Add −x to both sides: −x + x + y = −x + x + z.", "N2: 0 + y = 0 + z.", "N1: y = z."], "langType": "§2 ex. 22" },
    { "id": "b1.2.12", "n": 12, "prompt": "Prove: if $b + a = b$, then $a = 0$.", "answer": { "type": "self-check" }, "answerText": "Add −b to both sides", "solution": ["Add −b to both sides: −b + b + a = −b + b.", "N2: 0 + a = 0.", "N1: a = 0."], "langType": "§2 ex. 23" }
  ]
