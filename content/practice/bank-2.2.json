  "problems": [
    {
      "id": "b2.2.01",
      "n": 1,
      "prompt": "Solve $x + y + z = 3$, $x - y + z = 1$, $x + y - z = 1$.",
      "answer": {
        "type": "triple",
        "values": {
          "x": 1.0,
          "y": 1.0,
          "z": 1.0
        }
      },
      "answerText": "(1, 1, 1)",
      "solution": [
        "Row 1 minus row 2: 2y = 2, so y = 1.",
        "Row 1 minus row 3: 2z = 2, so z = 1.",
        "Then x = 3 − 1 − 1 = 1."
      ],
      "langType": "§2 ex. 1–8",
      "hints": [
        "Subtract rows in pairs. Remove the same letter each time."
      ]
    },
    {
      "id": "b2.2.02",
      "n": 2,
      "prompt": "Solve $2x + y - z = 1$, $x - y + 2z = 5$, $3x + 2y + z = 10$.",
      "answer": {
        "type": "triple",
        "values": {
          "x": 1.0,
          "y": 2.0,
          "z": 3.0
        }
      },
      "answerText": "(1, 2, 3)",
      "solution": [
        "Remove z. Row 1 plus row 3: 5x + 3y = 11.",
        "Row 2 plus 2 · row 1: 5x + y = 7.",
        "Subtract: 2y = 4, so y = 2. Then x = 1.",
        "Row 1: 2 + 2 − z = 1, so z = 3."
      ],
      "langType": "§2 ex. 1–8",
      "hints": [
        "Add row 1 and row 3. The z terms cancel."
      ]
    },
    {
      "id": "b2.2.03",
      "n": 3,
      "prompt": "Solve $x + 2y + z = 4$, $2x - y + z = 2$, $x + y - z = 1$.",
      "answer": {
        "type": "triple",
        "values": {
          "x": 1.0,
          "y": 1.0,
          "z": 1.0
        }
      },
      "answerText": "(1, 1, 1)",
      "solution": [
        "Row 1 plus row 3: 2x + 3y = 5.",
        "Row 2 plus row 3: 3x = 3, so x = 1.",
        "Then y = 1 and z = 1."
      ],
      "langType": "§2 ex. 1–8",
      "hints": [
        "Remove z from two pairs."
      ]
    },
    {
      "id": "b2.2.04",
      "n": 4,
      "prompt": "Solve $x - y + z = 2$, $2x + y - z = 1$, $x + y + z = 4$.",
      "answer": {
        "type": "triple",
        "values": {
          "x": 1.0,
          "y": 1.0,
          "z": 2.0
        }
      },
      "answerText": "(1, 1, 2)",
      "solution": [
        "Row 1 plus row 2: 3x = 3, so x = 1.",
        "Row 1 subtract row 3: −2y = −2, so y = 1.",
        "Then z = 4 − 1 − 1 = 2."
      ],
      "langType": "§2 ex. 1–8",
      "hints": [
        "Add rows 1 and 2. Two letters cancel."
      ]
    },
    {
      "id": "b2.2.05",
      "n": 5,
      "prompt": "Solve $\\tfrac{1}{2}x + y - z = 0$, $x - \\tfrac{1}{3}y + z = 5$, $x + y + z = 9$.",
      "answer": {
        "type": "triple",
        "values": {
          "x": 2.0,
          "y": 3.0,
          "z": 4.0
        }
      },
      "answerText": "(2, 3, 4)",
      "solution": [
        "Multiply row 1 by 2 and row 2 by 3: x + 2y − 2z = 0 and 3x − y + 3z = 15.",
        "Remove one letter from two pairs.",
        "The solution is x = 2, y = 3, z = 4."
      ],
      "langType": "§2 ex. 9–12",
      "hints": [
        "Multiply each equation with a fraction. Then all numbers are integers."
      ]
    },
    {
      "id": "b2.2.06",
      "n": 6,
      "prompt": "Solve $\\tfrac{2}{3}x - y + z = 1$, $x + \\tfrac{1}{2}y - z = 3$, $x + y + z = 6$.",
      "answer": {
        "type": "triple",
        "values": {
          "x": 3.0,
          "y": 2.0,
          "z": 1.0
        }
      },
      "answerText": "(3, 2, 1)",
      "solution": [
        "Multiply row 1 by 3 and row 2 by 2: 2x − 3y + 3z = 3 and 2x + y − 2z = 6.",
