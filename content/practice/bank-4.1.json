      "prompt": "Solve $x^2 - 4x = 5$.",
      "answer": {
        "type": "set",
        "values": [
          "5",
          "-1"
        ]
      },
      "answerText": "5 or −1",
      "solution": [
        "Add 4 to the two sides: (x − 2)² = 9.",
        "x − 2 = ±3, so x = 5 or x = −1."
      ],
      "langType": "Ch 4 examples 1–3",
      "hints": [
        "Complete the square. Type the solutions with a comma."
      ]
    },
