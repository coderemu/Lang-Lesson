    {
      "id": "b4.1.04",
      "n": 4,
      "prompt": "Solve $3x^2 + 6x - 9 = 0$.",
      "answer": {
        "type": "set",
        "values": [
          "1",
          "-3"
        ]
      },
      "answerText": "1 or −3",
      "solution": [
        "Divide by 3: x² + 2x − 3 = 0, so x² + 2x = 3.",
        "Add 1: (x + 1)² = 4. So x + 1 = ±2, and x = 1 or x = −3."
      ],
      "langType": "Ch 4 example 3",
      "hints": [
        "Divide by 3 first."
      ]
    },
    {
