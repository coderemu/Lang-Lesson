{
  "rules": [
    { "id": "comm-add", "label": "COMMUTATIVITY · ADDITION", "name": "Commutativity of addition", "statement": "\\va{a} + \\vb{b} = \\vb{b} + \\va{a}", "spoken": "a plus b equals b plus a", "status": "assumed", "lesson": "1.2", "book": "Ch 1 §2", "example": "3 + 5 = 5 + 3 = 8" },
    { "id": "assoc-add", "label": "ASSOCIATIVITY · ADDITION", "name": "Associativity of addition", "statement": "(\\va{a} + \\vb{b}) + \\vc{c} = \\va{a} + (\\vb{b} + \\vc{c})", "status": "assumed", "lesson": "1.2", "book": "Ch 1 §2", "example": "(3 + 5) + 9 = 3 + (5 + 9) = 17" },
    { "id": "N1", "label": "RULE N1 · ADDING 0", "name": "Adding zero", "statement": "0 + \\va{a} = \\va{a} + 0 = \\va{a}", "spoken": "zero plus a equals a", "status": "assumed", "lesson": "1.2", "book": "Ch 1 §1" },
    { "id": "N2", "label": "RULE N2 · ADDITIVE INVERSE", "name": "Additive inverse", "statement": "\\va{a} + (-\\va{a}) = 0 \\text{ and } -\\va{a} + \\va{a} = 0", "spoken": "a plus minus a equals zero", "status": "assumed", "lesson": "1.2", "book": "Ch 1 §1" },
    { "id": "N3", "label": "RULE N3 · ONE UNDO ONLY", "name": "Uniqueness of the inverse", "statement": "\\text{If } \\va{a} + \\vb{b} = 0, \\text{ then } \\vb{b} = -\\va{a} \\text{ and } \\va{a} = -\\vb{b}", "status": "proved", "lesson": "1.2", "book": "Ch 1 §2" },
    { "id": "N4", "label": "RULE N4 · MINUS MINUS", "name": "Minus of minus", "statement": "-(-\\va{a}) = \\va{a}", "spoken": "minus minus a equals a", "status": "proved", "lesson": "1.2", "book": "Ch 1 §2" },
    { "id": "N5", "label": "RULE N5 · MINUS OF A SUM", "name": "Minus of a sum", "statement": "-(\\va{a} + \\vb{b}) = -\\va{a} - \\vb{b}", "status": "proved", "lesson": "1.2", "book": "Ch 1 §2", "example": "-(-4 + 5) = 4 - 5 = -1" },
    { "id": "pos-sum", "label": "POSITIVE SUM", "name": "Sum of positive integers", "statement": "\\text{If } \\va{a}, \\vb{b} > 0, \\text{ then } \\va{a} + \\vb{b} > 0", "status": "assumed", "lesson": "1.2", "book": "Ch 1 §2" },
    { "id": "neg-sum", "label": "NEGATIVE SUM", "name": "Sum of negative integers", "statement": "\\text{If } \\va{a}, \\vb{b} < 0, \\text{ then } \\va{a} + \\vb{b} < 0", "status": "proved", "lesson": "1.2", "book": "Ch 1 §2" },
    { "id": "solve-sum", "label": "SOLVE A SUM", "name": "Solve a sum for one term", "statement": "\\text{If } \\va{a} + \\vb{b} = \\vc{c}, \\text{ then } \\va{a} = \\vc{c} - \\vb{b}", "status": "proved", "lesson": "1.2", "book": "Ch 1 §2" },
    { "id": "cancel-add", "label": "CANCELLATION · ADDITION", "name": "Cancellation law for addition", "statement": "\\text{If } \\va{a} + \\vb{b} = \\va{a} + \\vc{c}, \\text{ then } \\vb{b} = \\vc{c}", "status": "left-to-reader", "lesson": "1.2", "book": "Ch 1 §2, ex. 22" },

    { "id": "comm-mul", "label": "COMMUTATIVITY · MULTIPLICATION", "name": "Commutativity of multiplication", "statement": "\\va{a}\\vb{b} = \\vb{b}\\va{a}", "status": "assumed", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "assoc-mul", "label": "ASSOCIATIVITY · MULTIPLICATION", "name": "Associativity of multiplication", "statement": "(\\va{a}\\vb{b})\\vc{c} = \\va{a}(\\vb{b}\\vc{c})", "status": "assumed", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "N6", "label": "RULE N6 · TIMES 1, TIMES 0", "name": "Multiplication by 1 and 0", "statement": "1\\va{a} = \\va{a} \\text{ and } 0\\va{a} = 0", "status": "assumed", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "zero-mul", "label": "0a = 0 · PROOF", "name": "Zero times a number", "statement": "0\\va{a} = 0", "status": "proved", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "distrib", "label": "DISTRIBUTIVITY", "name": "Distributivity", "statement": "\\va{a}(\\vb{b} + \\vc{c}) = \\va{a}\\vb{b} + \\va{a}\\vc{c}", "status": "assumed", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "distrib-right", "label": "DISTRIBUTIVITY · OTHER SIDE", "name": "Distributivity on the other side", "statement": "(\\vb{b} + \\vc{c})\\va{a} = \\vb{b}\\va{a} + \\vc{c}\\va{a}", "status": "proved", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "N7", "label": "RULE N7", "name": "Minus one times a", "statement": "(-1)\\va{a} = -\\va{a}", "status": "proved", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "N8", "label": "RULE N8", "name": "Minus of a product (left)", "statement": "-(\\va{a}\\vb{b}) = (-\\va{a})\\vb{b}", "status": "proved", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "N9", "label": "RULE N9", "name": "Minus of a product (right)", "statement": "-(\\va{a}\\vb{b}) = \\va{a}(-\\vb{b})", "status": "left-to-reader", "lesson": "1.3", "book": "Ch 1 §3" },
    { "id": "N10", "label": "RULE N10 · MINUS TIMES MINUS", "name": "Minus times minus", "statement": "(-\\va{a})(-\\vb{b}) = \\va{a}\\vb{b}", "status": "left-to-reader", "lesson": "1.3", "book": "Ch 1 §3" },

    { "id": "N11", "label": "RULE N11 · ADD EXPONENTS", "name": "Product of powers", "statement": "\\va{a}^{m+n} = \\va{a}^m \\va{a}^n", "status": "shown", "lesson": "1.4", "book": "Ch 1 §3" },
    { "id": "N12", "label": "RULE N12 · MULTIPLY EXPONENTS", "name": "Power of a power", "statement": "(\\va{a}^m)^n = \\va{a}^{mn}", "status": "shown", "lesson": "1.4", "book": "Ch 1 §3" },
    { "id": "pow-prod", "label": "POWER OF A PRODUCT", "name": "Power of a product", "statement": "(\\va{a}\\vb{b})^n = \\va{a}^n \\vb{b}^n", "status": "shown", "lesson": "1.4", "book": "Ch 1 §3" },
    { "id": "sq-sum", "label": "FORMULA · SQUARE OF A SUM", "name": "Square of a sum", "statement": "(\\va{a} + \\vb{b})^2 = \\va{a}^2 + 2\\va{a}\\vb{b} + \\vb{b}^2", "status": "proved", "lesson": "1.4", "book": "Ch 1 §3" },
    { "id": "sq-diff", "label": "FORMULA · SQUARE OF A DIFFERENCE", "name": "Square of a difference", "statement": "(\\va{a} - \\vb{b})^2 = \\va{a}^2 - 2\\va{a}\\vb{b} + \\vb{b}^2", "status": "proved", "lesson": "1.4", "book": "Ch 1 §3" },
    { "id": "diff-sq", "label": "FORMULA · DIFFERENCE OF SQUARES", "name": "Difference of squares", "statement": "(\\va{a} + \\vb{b})(\\va{a} - \\vb{b}) = \\va{a}^2 - \\vb{b}^2", "status": "proved", "lesson": "1.4", "book": "Ch 1 §3" },

    { "id": "thm-1", "label": "THEOREM 1 · EVEN AND ODD SUMS", "name": "Even and odd sums", "statement": "\\text{even} + \\text{odd} = \\text{odd},\\ \\text{even} + \\text{even} = \\text{even},\\ \\text{odd} + \\text{odd} = \\text{even}", "status": "left-to-reader", "lesson": "1.5", "book": "Ch 1 §4" },
    { "id": "thm-2", "label": "THEOREM 2", "name": "Squares keep parity", "statement": "\\va{a} \\text{ even} \\Rightarrow \\va{a}^2 \\text{ even};\\ \\va{a} \\text{ odd} \\Rightarrow \\va{a}^2 \\text{ odd}", "status": "proved", "lesson": "1.5", "book": "Ch 1 §4" },
    { "id": "thm-2-cor", "label": "COROLLARY OF THEOREM 2", "name": "Even square, even root", "statement": "\\va{a}^2 \\text{ even} \\Rightarrow \\va{a} \\text{ even}", "status": "proved", "lesson": "1.5", "book": "Ch 1 §4" },
    { "id": "divides", "label": "DEFINITION · DIVIDES", "name": "d divides n", "statement": "d \\mid n \\iff n = dk \\text{ for an integer } k", "status": "shown", "lesson": "1.5", "book": "Ch 1 §4" },

    { "id": "cross-mul", "label": "CROSS-MULTIPLICATION", "name": "Cross-multiplication rule", "statement": "\\frac{m}{n} = \\frac{r}{s} \\iff ms = rn", "status": "assumed", "lesson": "1.6", "book": "Ch 1 §5" },
    { "id": "cancel-frac", "label": "CANCELLATION RULE · FRACTIONS", "name": "Cancellation rule for fractions", "statement": "\\frac{am}{an} = \\frac{m}{n};\\ \\frac{-m}{n} = \\frac{m}{-n}", "status": "proved", "lesson": "1.6", "book": "Ch 1 §5" },
    { "id": "thm-3", "label": "THEOREM 3 · LOWEST FORM", "name": "Lowest form", "statement": "\\text{Each positive rational number is } \\tfrac{m}{n} \\text{ with } m, n \\text{ not both even}", "status": "proved", "lesson": "1.6", "book": "Ch 1 §5" },
    { "id": "frac-ops", "label": "SUM AND PRODUCT OF FRACTIONS", "name": "Sum and product of fractions", "statement": "\\frac{m}{n} + \\frac{r}{s} = \\frac{ms + rn}{ns},\\quad \\frac{m}{n}\\cdot\\frac{r}{s} = \\frac{mr}{ns}", "status": "shown", "lesson": "1.6", "book": "Ch 1 §5" },
    { "id": "rules-rational", "label": "RULES FOR RATIONAL NUMBERS", "name": "The rules stay true for rational numbers", "statement": "\\text{Commutativity, associativity, distributivity, N1–N12 hold for rational numbers}", "status": "assumed", "lesson": "1.6", "book": "Ch 1 §5" },
    { "id": "thm-4", "label": "THEOREM 4", "name": "No rational square root of 2", "statement": "\\text{No positive rational number has square } 2", "status": "proved", "lesson": "1.7", "book": "Ch 1 §5" },

    { "id": "inverse-exists", "label": "MULTIPLICATIVE INVERSE", "name": "Inverse of a nonzero rational", "statement": "\\va{a} \\neq 0 \\Rightarrow \\va{a}\\va{a}^{-1} = 1", "status": "shown", "lesson": "1.8", "book": "Ch 1 §6" },
    { "id": "inverse-unique", "label": "ONE INVERSE ONLY", "name": "Uniqueness of the inverse", "statement": "\\va{a}\\vb{b} = 1 \\Rightarrow \\vb{b} = \\va{a}^{-1}", "status": "proved", "lesson": "1.8", "book": "Ch 1 §6" },
    { "id": "zero-product", "label": "ZERO PRODUCT", "name": "Zero product", "statement": "\\va{a}\\vb{b} = 0 \\Rightarrow \\va{a} = 0 \\text{ or } \\vb{b} = 0", "status": "proved", "lesson": "1.8", "book": "Ch 1 §6" },
    { "id": "cross-mul-proved", "label": "CROSS-MULTIPLICATION · PROVED", "name": "Cross-multiplication for rational numbers", "statement": "\\frac{\\va{a}}{\\vb{b}} = \\frac{c}{d} \\iff \\va{a}d = \\vb{b}c", "status": "proved", "lesson": "1.8", "book": "Ch 1 §6" },
    { "id": "cancel-mul", "label": "CANCELLATION LAW · MULTIPLICATION", "name": "Cancellation law for multiplication", "statement": "\\va{a} \\neq 0,\\ \\va{a}\\vb{b} = \\va{a}\\vc{c} \\Rightarrow \\vb{b} = \\vc{c}", "status": "proved", "lesson": "1.8", "book": "Ch 1 §6" },

    { "id": "elimination", "label": "ELIMINATION", "name": "Elimination method", "statement": "\\text{Make one coefficient equal, then add or subtract the equations}", "status": "shown", "lesson": "2.1", "book": "Ch 2 §1" },
    { "id": "elim-three", "label": "ELIMINATION · THREE UNKNOWNS", "name": "Eliminate one letter at a time", "statement": "\\text{Remove the same letter from two pairs, then solve two unknowns}", "status": "shown", "lesson": "2.2", "book": "Ch 2 §2" },
    { "id": "general-system", "label": "THE GENERAL SYSTEM", "name": "Solution when ad − bc ≠ 0", "statement": "x = \\frac{ud - bv}{ad - bc},\\ y = \\frac{av - cu}{ad - bc}", "status": "left-to-reader", "lesson": "2.3", "book": "Ch 2 §1, ex. 9–11" },

    { "id": "rules-real", "label": "RULES FOR REAL NUMBERS", "name": "The rules stay true for real numbers", "statement": "\\text{Addition and multiplication obey the same rules; } \\va{a} \\neq 0 \\text{ has an inverse}", "status": "assumed", "lesson": "3.1", "book": "Ch 3 §1" },
    { "id": "POS1", "label": "POS 1", "name": "Positive sums and products", "statement": "\\va{a}, \\vb{b} > 0 \\Rightarrow \\va{a}\\vb{b} > 0,\\ \\va{a} + \\vb{b} > 0", "status": "assumed", "lesson": "3.2", "book": "Ch 3 §2" },
    { "id": "POS2", "label": "POS 2", "name": "Three cases", "statement": "\\va{a} > 0, \\text{ or } \\va{a} = 0, \\text{ or } -\\va{a} > 0, \\text{ and only one}", "status": "assumed", "lesson": "3.2", "book": "Ch 3 §2" },
    { "id": "one-positive", "label": "1 IS POSITIVE", "name": "1 is positive", "statement": "1 > 0", "status": "proved", "lesson": "3.2", "book": "Ch 3 §2" },
    { "id": "sign-rules", "label": "SIGN RULES", "name": "Signs of products and inverses", "statement": "\\va{a} > 0, \\vb{b} < 0 \\Rightarrow \\va{a}\\vb{b} < 0;\\ \\va{a} < 0 \\Rightarrow \\va{a}^{-1} < 0", "status": "left-to-reader", "lesson": "3.2", "book": "Ch 3 §2, ex. 1–3" },
    { "id": "sqrt-exists", "label": "SQUARE ROOTS EXIST", "name": "Existence of square roots", "statement": "\\va{a} > 0 \\Rightarrow \\text{there is } b \\text{ with } b^2 = \\va{a}", "status": "assumed", "lesson": "3.2", "book": "Ch 3 §2" },
    { "id": "two-roots", "label": "EXACTLY TWO ROOTS", "name": "Two square roots", "statement": "x^2 = \\vb{b}^2 \\Rightarrow x = \\vb{b} \\text{ or } x = -\\vb{b}", "status": "proved", "lesson": "3.2", "book": "Ch 3 §2" },
    { "id": "abs", "label": "DEFINITION · ABSOLUTE VALUE", "name": "Absolute value", "statement": "|x| = \\sqrt{x^2}", "status": "shown", "lesson": "3.2", "book": "Ch 3 §2" },
    { "id": "rationalise", "label": "RATIONALISE", "name": "Remove a root from a fraction", "statement": "(x + y)(x - y) = x^2 - y^2", "status": "shown", "lesson": "3.3", "book": "Ch 3 §2" },
    { "id": "nth-root-exists", "label": "n-TH ROOTS EXIST", "name": "Existence of n-th roots", "statement": "\\va{a} > 0 \\Rightarrow \\text{a unique } r > 0 \\text{ with } r^n = \\va{a}", "status": "assumed", "lesson": "3.4", "book": "Ch 3 §3" },
    { "id": "thm-roots", "label": "THEOREM 1 (CH 3)", "name": "Root of a product", "statement": "(\\va{a}\\vb{b})^{1/n} = \\va{a}^{1/n}\\vb{b}^{1/n}", "status": "proved", "lesson": "3.4", "book": "Ch 3 §3" },
    { "id": "POW1", "label": "POW 1", "name": "Add exponents", "statement": "\\va{a}^{x+y} = \\va{a}^x\\va{a}^y", "status": "assumed", "lesson": "3.4", "book": "Ch 3 §3" },
    { "id": "POW2", "label": "POW 2", "name": "Multiply exponents", "statement": "(\\va{a}^x)^y = \\va{a}^{xy}", "status": "assumed", "lesson": "3.4", "book": "Ch 3 §3" },
    { "id": "POW3", "label": "POW 3", "name": "Power of a product", "statement": "(\\va{a}\\vb{b})^x = \\va{a}^x\\vb{b}^x", "status": "assumed", "lesson": "3.4", "book": "Ch 3 §3" },
    { "id": "zero-pow", "label": "ZERO AND NEGATIVE POWERS", "name": "Zero and negative exponents", "statement": "\\va{a}^0 = 1,\\ \\va{a}^{-x} = \\frac{1}{\\va{a}^x}", "status": "proved", "lesson": "3.4", "book": "Ch 3 §3" },
    { "id": "IN1", "label": "IN 1", "name": "Order is transitive", "statement": "\\va{a} > \\vb{b},\\ \\vb{b} > \\vc{c} \\Rightarrow \\va{a} > \\vc{c}", "status": "proved", "lesson": "3.5", "book": "Ch 3 §4" },
    { "id": "IN2", "label": "IN 2", "name": "Multiply by a positive", "statement": "\\va{a} > \\vb{b},\\ \\vc{c} > 0 \\Rightarrow \\va{a}\\vc{c} > \\vb{b}\\vc{c}", "status": "proved", "lesson": "3.5", "book": "Ch 3 §4" },
    { "id": "IN3", "label": "IN 3", "name": "Multiply by a negative", "statement": "\\va{a} > \\vb{b},\\ \\vc{c} < 0 \\Rightarrow \\va{a}\\vc{c} < \\vb{b}\\vc{c}", "status": "left-to-reader", "lesson": "3.5", "book": "Ch 3 §4" },
    { "id": "ineq-rules", "label": "MORE INEQUALITY RULES", "name": "Rules from exercises 2–8", "statement": "\\text{Add, multiply, invert and cross-multiply inequalities}", "status": "left-to-reader", "lesson": "3.6", "book": "Ch 3 §4, ex. 2–8" },

    { "id": "complete-square", "label": "COMPLETE THE SQUARE", "name": "Completing the square", "statement": "x^2 + bx + \\left(\\tfrac{b}{2}\\right)^2 = \\left(x + \\tfrac{b}{2}\\right)^2", "status": "shown", "lesson": "4.1", "book": "Ch 4" },
    { "id": "quadratic-formula", "label": "THE QUADRATIC FORMULA", "name": "Quadratic formula", "statement": "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}", "spoken": "x equals minus b, plus or minus root of b squared minus 4ac, over 2a", "status": "proved", "lesson": "4.2", "book": "Ch 4" }
  ]
}
