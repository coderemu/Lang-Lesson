{
  "name": "lang-lessons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "e2e": "playwright test",
    "qa:1a": "playwright test -c playwright.qa.config.ts e2e/qa-1a.spec.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:coverage": "vitest run --coverage",
    "qa:1b": "playwright test -c playwright.qa.config.ts e2e/qa-1b.spec.ts",
    "qa:1c": "playwright test -c playwright.qa.config.ts e2e/qa-1c.spec.ts",
    "qa:1e": "playwright test -c playwright.qa.config.ts e2e/qa-1e.spec.ts",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name lang-lessons",
    "icons": "tsx scripts/make-icons.ts",
    "e2e:preview": "playwright test -c playwright.preview.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/stix-two-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "katex": "^0.19.1",
    "mathjs": "^15.2.0",
    "motion": "^14.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
